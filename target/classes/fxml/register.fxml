<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.RegisterController">
    <VBox alignment="CENTER" spacing="15" styleClass="auth-panel" stylesheets="@../css/style.css" maxWidth="400">
        <Label styleClass="app-title" text="SyncTalk" />
        <Label styleClass="sub-title" text="Create your account" />

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #444;" text="Username" />
            <TextField fx:id="usernameField" promptText="Choose a username" styleClass="input-field" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #444;" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Choose a password" styleClass="input-field" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #444;" text="Display Name" />
            <TextField fx:id="displayNameField" promptText="Enter your display name" styleClass="input-field" />
        </VBox>

        <Label fx:id="errorLabel" textFill="#e4405f" wrapText="true" style="-fx-font-size: 12px;" />

        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleRegister" styleClass="btn-success" text="Sign Up" />

        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #65676b; -fx-font-size: 13px;" text="Already have an account?" />
            <Hyperlink fx:id="loginLink" onAction="#goToLogin" style="-fx-text-fill: #1877f2; -fx-font-size: 13px;" text="Log in" />
        </HBox>

        <HBox alignment="CENTER" spacing="5">
            <Label styleClass="footer-text" text="Built by Bhavini Awasthi" />
        </HBox>
    </VBox>
</StackPane>
