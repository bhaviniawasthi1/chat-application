<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.CreateGroupController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Create New Group" />

    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #444;" text="Group Name" />
    <TextField fx:id="groupNameField" promptText="Enter group name" styleClass="input-field" />

    <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #444;" text="Select Members" />
    <ListView fx:id="userListView" prefHeight="250" styleClass="list-view" VBox.vgrow="ALWAYS" />

    <Label fx:id="errorLabel" textFill="#e4405f" wrapText="true" style="-fx-font-size: 12px;" />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" styleClass="btn-secondary" text="Cancel" />
        <Button fx:id="createButton" mnemonicParsing="false" onAction="#handleCreate" styleClass="btn-success" text="Create Group" />
    </HBox>

    <HBox alignment="CENTER" spacing="5">
        <Label styleClass="footer-text" text="Built by Bhavini Awasthi" />
    </HBox>
</VBox>
