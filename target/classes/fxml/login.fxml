<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.LoginController">
    <VBox alignment="CENTER" spacing="15" styleClass="auth-panel" stylesheets="@../css/style.css">
        <Label styleClass="app-title" text="SyncTalk" />
        <Label styleClass="sub-title" text="Welcome back!" />

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #444;" text="Username" />
            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="input-field" />
        </VBox>

        <VBox spacing="8">
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #444;" text="Password" />
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field" />
        </VBox>

        <Label fx:id="errorLabel" textFill="#e4405f" wrapText="true" style="-fx-font-size: 12px;" />

        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-primary" text="Log In" />

        <HBox alignment="CENTER" spacing="5">
            <Label style="-fx-text-fill: #65676b; -fx-font-size: 13px;" text="Don't have an account?" />
            <Hyperlink fx:id="registerLink" onAction="#goToRegister" style="-fx-text-fill: #1877f2; -fx-font-size: 13px;" text="Sign up" />
        </HBox>

        <HBox alignment="CENTER" spacing="5">
            <Label styleClass="footer-text" text="Built by Bhavini Awasthi" />
        </HBox>
    </VBox>
</StackPane>
