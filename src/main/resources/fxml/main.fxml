<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.MainController">
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-bar">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label styleClass="header-title" text="SyncTalk" />
            <Label fx:id="welcomeLabel" styleClass="header-sub" />
        </VBox>
        <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 8px; -fx-padding: 8px 16px; -fx-font-weight: bold;" text="Logout" />
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-padding: 15px 20px;">
        <Label fx:id="errorLabel" textFill="#ff9800" wrapText="true" style="-fx-font-size: 12px;" />

        <HBox spacing="5" alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Online Users" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#handleRefresh" styleClass="btn-warning" text="Refresh" />
        </HBox>
        <ListView fx:id="userListView" prefHeight="160" styleClass="list-view" VBox.vgrow="ALWAYS" />

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Your Groups" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleCreateGroup" styleClass="btn-success" text="+ New Group" />
        </HBox>
        <ListView fx:id="groupListView" prefHeight="140" styleClass="list-view" VBox.vgrow="ALWAYS" />
    </VBox>

    <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10px;">
        <Label styleClass="footer-text" text="Built by Bhavini Awasthi" />
    </HBox>
</VBox>
