<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.ChatController">
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="header-bar">
        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 8px; -fx-padding: 6px 14px; -fx-font-weight: bold;" text="&lt; Back" />
        <Label fx:id="chatWithLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" />
    </HBox>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">
        <VBox fx:id="messageContainer" spacing="5" style="-fx-padding: 15px; -fx-background-color: #f0f2f5;" />
    </ScrollPane>

    <Label fx:id="errorLabel" textFill="#e4405f" wrapText="true" style="-fx-padding: 5px 20px; -fx-font-size: 12px;" />

    <HBox spacing="10" style="-fx-padding: 10px 20px 15px 20px; -fx-background-color: white; -fx-background-radius: 10px 10px 0 0;">
        <TextField fx:id="messageField" onAction="#handleSend" promptText="Type a message..." HBox.hgrow="ALWAYS" styleClass="chat-input" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleSend" style="-fx-background-color: #1877f2; -fx-text-fill: white; -fx-background-radius: 50%; -fx-min-width: 40px; -fx-min-height: 40px; -fx-font-size: 18px -fx-font-weight: bold;" text="Send" />
    </HBox>

    <HBox alignment="CENTER" spacing="5" style="-fx-padding: 8px;">
        <Label styleClass="footer-text" text="Built by Bhavini Awasthi" />
    </HBox>
</VBox>
